DISCORD_TOKEN=
DATABASE_URL=

# Opcionales: ausentes o vacíos utilizan la imagen predeterminada de cada fase en config/settings.py.
# Los nombres _GIF se conservan por compatibilidad y también aceptan URLs WebP.
ES_DOOR_CLOSED_GIF=
ES_DOOR_WAITING_GIF=
ES_DOOR_CANDY_WIN_GIF=
ES_DOOR_CANDY_LOSE_GIF=
ES_DOOR_TIMEOUT=
BR_DOOR_CLOSED_GIF=
BR_DOOR_WAITING_GIF=
BR_DOOR_CANDY_WIN_GIF=
BR_DOOR_CANDY_LOSE_GIF=
BR_DOOR_TIMEOUT=

# Copias reutilizables en Discord. Vacío desactiva esta opción y conserva los enlaces R2.
DISCORD_MEDIA_CACHE_CHANNEL_ID=1556194178902396999
# Renueva una sola vez por valor. Después del primer despliegue puede dejarse vacío.
DISCORD_MEDIA_CACHE_REFRESH_KEY=optimized-20261013-v1

# Opcionales: certificados de Aiven, sin cambiar DATABASE_URL.
DATABASE_CA_FILE=
DATABASE_CA_PEM=
# Sin certificado explícito, se respeta sslmode=require/verify-full de la URL.
LOG_LEVEL=INFO
# Para sincronizar comandos al instante en un servidor de desarrollo:
COMMAND_GUILD_ID=
